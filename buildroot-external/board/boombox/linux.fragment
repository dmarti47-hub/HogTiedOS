# HogTiedOS kernel config fragment, applied on top of omap2plus_defconfig.

# --- Keep away from the DRAM controller and power rails --------------------
# ARCH_OMAP2PLUS selects CONFIG_PM, so PM itself can't be disabled here; the
# board patch (patches/linux/0001-*) skips omap3_pm_init() at runtime. These
# remove the remaining paths that change clocks/voltages on undocumented
# silicon: DVFS, idle states, SmartReflex AVS.
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_POWER_AVS_OMAP is not set

# --- Console: UART3 (ttyS2), with earlycon for first-boot debugging --------
CONFIG_SERIAL_8250_OMAP=y
CONFIG_SERIAL_8250_OMAP_TTYO_FIXUP=y
CONFIG_SERIAL_EARLYCON=y

# --- Display: omapdrm + panel-dpi, fbdev emulation for an LVGL fb backend --
CONFIG_DRM=y
CONFIG_DRM_OMAP=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# --- IOC link (hbas-iocd): spidev on McSPI3, vcan for bike data to the UI --
CONFIG_SPI_SPIDEV=y
CONFIG_CAN_VCAN=y

# --- Bluetooth: CSR BlueCore on SDIO (MMC3), standard Type-A -> btsdio ----
# A2DP/AVRCP run over L2CAP in BlueZ userspace; BR/EDR pairing needs the
# crypto below built in (no modules on this image).
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTSDIO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# --- Image size: the IFS slot is 42 MiB and the IPL read limit is unknown --
# (ifsSizeInMB / set-ifs-size, see CROSS_CHECKS.md sec. 6). Keep it small.
# Kernel compression is set by BR2_LINUX_KERNEL_XZ in the defconfig
# (Buildroot overrides CONFIG_KERNEL_* from fragments).
# No loadable modules: omap2plus builds ~25 MB of modules for other boards.
# Drivers this board needs are built in explicitly above.
# CONFIG_MODULES is not set
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y

# HogTiedOS - Harley-Davidson Boom! Box 6.5GT
# Target Buildroot: 2025.02.x LTS

# CPU. TODO: unconfirmed - Cortex-A8 + NEON is inferred from "OMAP3-family";
# the DRA52x core has not been identified from firmware directly.
BR2_arm=y
BR2_cortex_a8=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_NEON=y

# Toolchain
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_GLIBC_STABLE=y

# Board patches (kernel: keep off the DRAM controller)
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_HOGTIED_PATH)/board/boombox/patches"

# System
BR2_TARGET_GENERIC_HOSTNAME="hogtied"
BR2_TARGET_GENERIC_ISSUE="Welcome to HogTiedOS"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS2"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.54"
BR2_LINUX_KERNEL_DEFCONFIG="omap2plus"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HOGTIED_PATH)/board/boombox/linux.fragment"
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_XZ=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_HOGTIED_PATH)/board/boombox/dts/hogtied-boombox.dts"

# Root filesystem: initramfs built into the kernel, so the whole OS is one
# blob in one IFS slot and nothing needs to be written to ETFS.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set

# No U-Boot: the stock QNX IPL is the bootloader. post-image.sh wraps
# zImage + DTB into images/hogtied.ifs (tools/ifs-pack) and validates it.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_HOGTIED_PATH)/board/boombox/post-image.sh"

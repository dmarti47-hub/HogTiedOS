#!/bin/sh
# Start the HogTiedOS main screen on the framebuffer.
# Bike data comes from hbas-iocd via vcan0 (shows "--" until frames arrive).
# Never start it with --demo on a bike: that shows fake data.
# Settings live on the eMMC (mounted read-only by S30emmc); the UI remounts it
# read-write only while saving.

DAEMON=/usr/bin/hogtied-ui
PIDFILE=/var/run/hogtied-ui.pid

case "$1" in
start)
	printf "Starting hogtied-ui: "
	# keep the framebuffer console cursor from blinking over the UI
	echo 0 > /sys/class/graphics/fbcon/cursor_blink 2>/dev/null
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- --can vcan0 \
		--settings /mnt/emmc/hogtied/settings.conf --settings-mount /mnt/emmc && echo OK || echo FAIL
	;;
stop)
	printf "Stopping hogtied-ui: "
	start-stop-daemon -K -p "$PIDFILE" && echo OK || echo FAIL
	rm -f "$PIDFILE"
	;;
restart)
	"$0" stop
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
